<style>
#ssa-afya{
  --ssa:#B23359; --ssa-d:#732039; --verde:#2CA36D; --verde-d:#105937;
  --cinza:#4A4A4A; --cinza-l:#A7A7A7; --afya:#E5195E; --afya-d:#8C0B3E;
  --bg:#FBF7F8; --linha:#EEE3E7; --branco:#fff;
  font-family:'Montserrat',system-ui,sans-serif; color:var(--cinza);
  background:var(--bg); line-height:1.55; font-size:16px;
  -webkit-font-smoothing:antialiased; overflow-x:hidden;
}
#ssa-afya *,#ssa-afya *::before,#ssa-afya *::after{box-sizing:border-box;margin:0;padding:0}
#ssa-afya img{max-width:100%;display:block}
#ssa-afya a{color:inherit}
#ssa-afya button{font-family:inherit;cursor:pointer;border:0;background:none;color:inherit}
#ssa-afya .wrap{max-width:1120px;margin:0 auto;padding:0 20px}
#ssa-afya h1,#ssa-afya h2,#ssa-afya h3{color:var(--ssa-d);line-height:1.15;letter-spacing:-.02em}
#ssa-afya h2{font-size:clamp(1.6rem,3.4vw,2.3rem);font-weight:800}
#ssa-afya .eyebrow{display:inline-block;font-size:.72rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ssa);margin-bottom:10px}
#ssa-afya section{padding:72px 0}
#ssa-afya .lead{font-size:1.05rem;max-width:620px;margin-top:12px}
#ssa-afya .btn{display:inline-flex;align-items:center;gap:10px;padding:14px 24px;border-radius:999px;font-weight:700;font-size:.95rem;text-decoration:none;transition:transform .2s,box-shadow .2s,background .2s}
#ssa-afya .btn:hover{transform:translateY(-2px)}
#ssa-afya .btn-light{background:#fff;color:var(--afya-d);box-shadow:0 8px 24px rgba(0,0,0,.18)}
#ssa-afya .btn-ghost{border:2px solid rgba(255,255,255,.6);color:#fff}
#ssa-afya .btn-ghost:hover{background:rgba(255,255,255,.12)}
#ssa-afya .btn-verde{background:var(--verde);color:#fff;box-shadow:0 8px 20px rgba(44,163,109,.3)}
#ssa-afya .btn-verde:hover{background:var(--verde-d)}
#ssa-afya .btn-ssa{background:var(--ssa);color:#fff}
#ssa-afya .btn-ssa:hover{background:var(--ssa-d)}
#ssa-afya .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}
#ssa-afya .reveal.on{opacity:1;transform:none}

/* ---------- Topo ---------- */
#ssa-afya .top{background:#fff;border-bottom:1px solid var(--linha)}
#ssa-afya .top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:14px;padding-bottom:14px}
#ssa-afya .logos{display:flex;align-items:center;gap:18px}
#ssa-afya .logos img.ssa{height:52px;width:auto}
#ssa-afya .logos img.afya{height:34px;width:auto}
#ssa-afya .logos .x{font-weight:300;font-size:1.4rem;color:var(--cinza-l)}
#ssa-afya .top .tag{font-size:.75rem;font-weight:700;color:var(--verde-d);background:#E6F5EE;padding:7px 14px;border-radius:999px;white-space:nowrap}

/* ---------- Hero ---------- */
#ssa-afya .hero{position:relative;background:linear-gradient(115deg,var(--afya) 0%,var(--ssa) 45%,var(--afya-d) 100%);color:#fff;padding:0;overflow:hidden}
#ssa-afya .hero::before{content:"";position:absolute;left:-120px;top:-60px;width:520px;height:620px;background:rgba(255,255,255,.07);clip-path:polygon(50% 0,100% 100%,78% 100%,50% 30%,22% 100%,0 100%)}
#ssa-afya .hero .wrap{position:relative;display:grid;grid-template-columns:1.1fr .9fr;align-items:end;gap:24px;min-height:500px;padding-top:0}
#ssa-afya .hero .txt{padding:64px 0}
#ssa-afya .hero h1{color:#fff;font-size:clamp(1.9rem,4vw,2.8rem);font-weight:800}
#ssa-afya .hero h1 em{font-style:normal;color:#FFD3E1}
#ssa-afya .hero p{font-size:1.08rem;margin:18px 0 28px;max-width:520px;opacity:.95}
#ssa-afya .pill{display:inline-block;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.3);padding:7px 14px;border-radius:999px;font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:14px}
#ssa-afya .pct{display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap}
#ssa-afya .pct .big{font-size:clamp(6rem,15vw,10.5rem);font-weight:900;line-height:.82;letter-spacing:-.06em;color:#fff;text-shadow:0 10px 40px rgba(80,0,30,.35)}
#ssa-afya .pct .big small{font-size:.5em;letter-spacing:-.02em;vertical-align:top;margin-left:4px}
#ssa-afya .pct .off{background:#fff;color:var(--afya-d);font-weight:900;font-size:clamp(1.2rem,2.4vw,1.6rem);padding:6px 14px;border-radius:10px;transform:rotate(-4deg);margin-bottom:12px;box-shadow:0 8px 20px rgba(0,0,0,.18)}
#ssa-afya .hero h1{margin-top:16px}
#ssa-afya .hero h1 .sub{display:block;font-size:.55em;font-weight:600;color:#FFD3E1;margin-top:12px;letter-spacing:-.01em}
#ssa-afya .foto{position:relative}
#ssa-afya .selo{position:absolute;left:-28px;top:18%;width:132px;height:132px;border-radius:50%;background:#fff;color:var(--afya-d);display:grid;place-items:center;text-align:center;box-shadow:0 14px 34px rgba(0,0,0,.25);transform:rotate(-10deg);animation:saPulse 2.6s ease-in-out infinite;z-index:2}
#ssa-afya .selo b{display:block;font-size:2.6rem;font-weight:900;line-height:.9;letter-spacing:-.04em}
#ssa-afya .selo span{display:block;font-size:.62rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;line-height:1.25;margin-top:4px}
#ssa-afya .selo::after{content:"";position:absolute;inset:6px;border-radius:50%;border:2px dashed rgba(178,51,89,.35)}
@keyframes saPulse{0%,100%{transform:rotate(-10deg) scale(1)}50%{transform:rotate(-10deg) scale(1.06)}}
#ssa-afya .ctas{display:flex;flex-wrap:wrap;gap:12px}
#ssa-afya .hero .foto{align-self:end;justify-self:center;max-width:470px;width:100%;filter:drop-shadow(0 20px 40px rgba(0,0,0,.25))}
#ssa-afya .hero .foto img{width:100%;border-radius:28px 28px 0 0;border:6px solid rgba(255,255,255,.18);border-bottom:0}

/* ---------- Faixa de destaques ---------- */
#ssa-afya .faixa{padding:0;margin-top:-1px}
#ssa-afya .fx-card{position:relative;top:-40px;background:#fff;border-radius:22px;box-shadow:0 18px 50px rgba(115,32,57,.14);display:grid;grid-template-columns:1.3fr 1fr 1fr;border-left:8px solid var(--verde);overflow:hidden}
#ssa-afya .fx{padding:24px 26px;display:flex;align-items:center;gap:16px;border-right:1px solid var(--linha)}
#ssa-afya .fx:last-child{border-right:0}
#ssa-afya .fx .ic{width:48px;height:48px;border-radius:14px;background:#FBE9EF;display:grid;place-items:center;flex-shrink:0}
#ssa-afya .fx .ic svg{width:24px;height:24px;stroke:var(--ssa)}
#ssa-afya .fx b{display:block;color:var(--ssa-d);font-size:1rem;line-height:1.25}
#ssa-afya .fx span{font-size:.84rem}
#ssa-afya .fx.main{background:linear-gradient(120deg,var(--ssa),var(--afya-d));color:#fff}
#ssa-afya .fx.main .n{font-size:3rem;font-weight:900;line-height:.9;letter-spacing:-.04em}
#ssa-afya .fx.main b{color:#fff}
#ssa-afya .fx.main span{opacity:.9}

/* ---------- Pra você? ---------- */
#ssa-afya .check{padding-top:32px}
#ssa-afya .grid2{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
#ssa-afya .quem{display:flex;flex-wrap:wrap;gap:10px;margin:22px 0}
#ssa-afya .chip{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--linha);border-radius:999px;padding:9px 16px;font-weight:600;font-size:.9rem;color:var(--ssa-d)}
#ssa-afya .chip i{width:8px;height:8px;border-radius:50%;background:var(--verde);display:inline-block}
#ssa-afya .mods{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:10px}
#ssa-afya .mod{background:#fff;border-radius:14px;padding:16px 12px;text-align:center;border:1px solid var(--linha);font-weight:700;font-size:.9rem;color:var(--ssa-d)}
#ssa-afya .mod svg{width:28px;height:28px;margin:0 auto 6px;stroke:var(--verde);display:block}
#ssa-afya .nao{margin-top:16px;font-size:.88rem;background:#fff;border-radius:12px;padding:12px 16px;border:1px dashed var(--cinza-l)}
#ssa-afya .nao b{color:var(--ssa)}
#ssa-afya .quiz{background:#fff;border-radius:22px;padding:28px;box-shadow:0 10px 36px rgba(115,32,57,.08)}
#ssa-afya .quiz h3{font-size:1.25rem;margin-bottom:4px}
#ssa-afya .quiz > p{font-size:.9rem;margin-bottom:18px}
#ssa-afya .q{display:flex;justify-content:space-between;align-items:center;gap:14px;padding:14px 0;border-top:1px solid var(--linha);font-weight:600;font-size:.93rem}
#ssa-afya .seg{display:flex;background:var(--bg);border-radius:999px;padding:4px;flex-shrink:0}
#ssa-afya .seg button{padding:7px 16px;border-radius:999px;font-weight:700;font-size:.82rem;color:var(--cinza)}
#ssa-afya .seg button.sim.on{background:var(--verde);color:#fff}
#ssa-afya .seg button.nao-b.on{background:var(--ssa);color:#fff}
#ssa-afya .res{margin-top:16px;border-radius:14px;padding:16px 18px;font-weight:600;font-size:.93rem;background:var(--bg);transition:background .3s,color .3s}
#ssa-afya .res.ok{background:#E6F5EE;color:var(--verde-d)}
#ssa-afya .res.no{background:#FBE9EF;color:var(--ssa-d)}

/* ---------- Simulador ---------- */
#ssa-afya .sim-sec{background:#fff}
#ssa-afya .sim-box{display:grid;grid-template-columns:1fr 1.1fr;gap:40px;align-items:center;margin-top:34px}
#ssa-afya .range-lbl{display:flex;justify-content:space-between;font-weight:600;font-size:.9rem;margin-bottom:10px}
#ssa-afya .range-lbl output{font-size:1.6rem;font-weight:800;color:var(--ssa-d)}
#ssa-afya input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:10px;border-radius:999px;background:linear-gradient(to right,var(--ssa) var(--p,30%),var(--linha) var(--p,30%));outline:none}
#ssa-afya input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:28px;height:28px;border-radius:50%;background:#fff;border:6px solid var(--ssa);box-shadow:0 4px 12px rgba(0,0,0,.2);cursor:pointer}
#ssa-afya input[type=range]::-moz-range-thumb{width:18px;height:18px;border-radius:50%;background:#fff;border:6px solid var(--ssa);cursor:pointer}
#ssa-afya .scale{display:flex;justify-content:space-between;font-size:.75rem;color:var(--cinza-l);margin-top:6px}
#ssa-afya .bars{margin-top:30px}
#ssa-afya .bar-row{margin-bottom:14px}
#ssa-afya .bar-row .l{display:flex;justify-content:space-between;font-size:.85rem;font-weight:600;margin-bottom:6px}
#ssa-afya .bar{height:16px;border-radius:999px;background:var(--bg);overflow:hidden}
#ssa-afya .bar span{display:block;height:100%;border-radius:999px;transition:width .5s cubic-bezier(.2,.8,.2,1)}
#ssa-afya .bar .b1{background:var(--cinza-l);width:100%}
#ssa-afya .bar .b2{background:var(--verde);width:60%}
#ssa-afya .kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
#ssa-afya .kpi{border-radius:18px;padding:22px 16px;text-align:center;background:var(--bg)}
#ssa-afya .kpi small{display:block;font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--cinza)}
#ssa-afya .kpi b{display:block;font-size:clamp(1.25rem,2.4vw,1.7rem);font-weight:800;color:var(--verde-d);margin-top:6px}
#ssa-afya .kpi.dest{background:linear-gradient(135deg,var(--verde),var(--verde-d));color:#fff}
#ssa-afya .kpi.dest small,#ssa-afya .kpi.dest b{color:#fff}
#ssa-afya .obs{font-size:.78rem;color:#7a7a7a;margin-top:14px}
#ssa-afya .frase{margin-top:18px;font-weight:600;color:var(--ssa-d);font-size:.98rem}

/* ---------- Passo a passo ---------- */
#ssa-afya .steps{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:34px;counter-reset:s}
#ssa-afya .step{position:relative;background:#fff;border-radius:20px;padding:24px 20px;border:2px solid transparent;text-align:left;transition:border-color .25s,transform .25s,box-shadow .25s}
#ssa-afya .step:hover,#ssa-afya .step.on{border-color:var(--ssa);transform:translateY(-4px);box-shadow:0 14px 30px rgba(178,51,89,.14)}
#ssa-afya .step .n{width:42px;height:42px;border-radius:12px;background:var(--ssa);color:#fff;font-weight:800;display:grid;place-items:center;font-size:1.1rem;margin-bottom:14px}
#ssa-afya .step:nth-child(4) .n{background:var(--verde)}
#ssa-afya .step h3{font-size:1rem;margin-bottom:6px}
#ssa-afya .step p{font-size:.86rem}
#ssa-afya .alerta{margin-top:22px;display:flex;gap:14px;align-items:center;background:var(--ssa-d);color:#fff;border-radius:16px;padding:16px 20px;font-size:.93rem}
#ssa-afya .alerta svg{flex-shrink:0;width:28px;height:28px;stroke:#FFD3E1}

/* ---------- Documentos ---------- */
#ssa-afya .docs-sec{background:#fff}
#ssa-afya .docs{display:grid;gap:10px;margin-top:24px}
#ssa-afya .doc{display:flex;align-items:center;gap:14px;background:var(--bg);border-radius:14px;padding:14px 16px;cursor:pointer;font-weight:600;font-size:.93rem;transition:background .2s;user-select:none}
#ssa-afya .doc input{position:absolute;opacity:0;pointer-events:none}
#ssa-afya .doc .box{width:24px;height:24px;border-radius:7px;border:2px solid var(--cinza-l);flex-shrink:0;display:grid;place-items:center;transition:all .2s}
#ssa-afya .doc .box svg{width:14px;height:14px;stroke:#fff;opacity:0}
#ssa-afya .doc.done{background:#E6F5EE}
#ssa-afya .doc.done .box{background:var(--verde);border-color:var(--verde)}
#ssa-afya .doc.done .box svg{opacity:1}
#ssa-afya .doc.done .t{text-decoration:line-through;text-decoration-color:rgba(16,89,55,.4);color:var(--verde-d)}
#ssa-afya .doc .t small{display:block;font-weight:500;font-size:.8rem;color:#777;text-decoration:none}
#ssa-afya .prog{margin-top:16px;display:flex;align-items:center;gap:12px;font-weight:700;font-size:.85rem;color:var(--verde-d)}
#ssa-afya .prog .bar{flex:1;height:10px}
#ssa-afya .prog .bar span{background:var(--verde);width:0}

/* ---------- Regras (acordeão) ---------- */
#ssa-afya .acc{margin-top:24px;display:grid;gap:10px}
#ssa-afya .acc details{background:#fff;border-radius:14px;border:1px solid var(--linha);overflow:hidden}
#ssa-afya .acc summary{list-style:none;cursor:pointer;padding:16px 18px;font-weight:700;color:var(--ssa-d);display:flex;justify-content:space-between;align-items:center;gap:10px}
#ssa-afya .acc summary::-webkit-details-marker{display:none}
#ssa-afya .acc summary::after{content:"+";font-size:1.4rem;font-weight:500;color:var(--ssa);transition:transform .25s}
#ssa-afya .acc details[open] summary::after{transform:rotate(45deg)}
#ssa-afya .acc ul{padding:0 18px 18px 36px;font-size:.9rem}
#ssa-afya .acc li{margin-bottom:6px}

/* ---------- Contato ---------- */
#ssa-afya .contato{background:linear-gradient(120deg,var(--ssa-d),var(--ssa));color:#fff;text-align:center}
#ssa-afya .contato h2{color:#fff}
#ssa-afya .contato .lead{margin:12px auto 26px;color:#fff;opacity:.92}
#ssa-afya .ct-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:0 auto 30px;max-width:900px;text-align:left}
#ssa-afya .ct{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:16px;padding:18px;font-size:.9rem}
#ssa-afya .ct b{display:block;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;opacity:.75;margin-bottom:4px}
#ssa-afya .ct a{text-decoration:none;font-weight:700}
#ssa-afya .rod{background:#fff;padding:22px 0;font-size:.78rem;color:#888;text-align:center}

/* ---------- Responsivo ---------- */
@media (max-width:900px){
  #ssa-afya .hero .wrap{grid-template-columns:1fr;min-height:0}
  #ssa-afya .hero .txt{padding:48px 0 8px}
  #ssa-afya .hero .foto{max-width:340px}
  #ssa-afya .fx-card{grid-template-columns:1fr}
  #ssa-afya .fx{border-right:0;border-bottom:1px solid var(--linha)}
  #ssa-afya .selo{left:auto;right:-6px;top:-30px;width:112px;height:112px}
  #ssa-afya .selo b{font-size:2.2rem}
  #ssa-afya .grid2,#ssa-afya .sim-box{grid-template-columns:1fr;gap:32px}
  #ssa-afya .steps{grid-template-columns:1fr 1fr}
  #ssa-afya .ct-grid{grid-template-columns:1fr}
}
@media (max-width:560px){
  #ssa-afya section{padding:56px 0}
  #ssa-afya .wrap{padding:0 16px}
  #ssa-afya .top .tag{display:none}
  #ssa-afya .logos img.ssa{height:42px}
  #ssa-afya .logos img.afya{height:28px}
  #ssa-afya .fx{padding:18px 20px}
  #ssa-afya .steps,#ssa-afya .kpis{grid-template-columns:1fr}
  #ssa-afya .q{flex-direction:column;align-items:flex-start}
  #ssa-afya .ctas .btn{width:100%;justify-content:center}
}
@media (prefers-reduced-motion:reduce){#ssa-afya *{transition:none!important}#ssa-afya .reveal{opacity:1;transform:none}}
</style>

