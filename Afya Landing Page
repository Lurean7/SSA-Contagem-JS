<script>
(function(){
  var R=document.getElementById('ssa-afya'); if(!R) return;
  var $=function(s){return R.querySelector(s)}, $$=function(s){return R.querySelectorAll(s)};
  var brl=function(v){return 'R$ '+Math.round(v).toLocaleString('pt-BR')};

  /* Animação de entrada */
  var els=$$('.reveal');
  if('IntersectionObserver' in window){
    var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('on');io.unobserve(e.target)}})},{threshold:.12});
    els.forEach(function(el){io.observe(el)});
  } else els.forEach(function(el){el.classList.add('on')});

  /* Quiz de elegibilidade */
  var ans=[null,null,null,null], res=$('#sa-res');
  var dicas=['O benefício é para colaboradores CLT, corpo clínico e dependentes (cônjuge e filhos).','O desconto é válido apenas para novos ingressantes na Afya.','Medicina, Odontologia e Medicina Veterinária não estão contemplados.','O desconto não é cumulativo com bolsas, financiamentos ou outros descontos.'];
  $$('.seg').forEach(function(seg){
    var i=+seg.getAttribute('data-q');
    seg.querySelectorAll('button').forEach(function(b){
      b.addEventListener('click',function(){
        seg.querySelectorAll('button').forEach(function(x){x.classList.remove('on')});
        b.classList.add('on'); ans[i]=b.classList.contains('sim'); upd();
      });
    });
  });
  function upd(){
    var no=ans.indexOf(false);
    res.className='res';
    if(no>-1){res.classList.add('no');res.innerHTML='Hmm, aqui tem um ponto de atenção: '+dicas[no]+' Na dúvida, fale com a equipe da Afya pelo WhatsApp.';return}
    if(ans.indexOf(null)>-1){res.textContent='Continue respondendo… ✨';return}
    res.classList.add('ok');res.innerHTML='🎉 Tudo indica que sim! Faça sua matrícula e peça o desconto em até 5 dias úteis.';
  }

  /* Simulador */
  var rg=$('#sa-range');
  function sim(){
    var v=+rg.value, m=v*.4;
    rg.style.setProperty('--p',((v-rg.min)/(rg.max-rg.min)*100)+'%');
    $('#sa-val').textContent=brl(v); $('#sa-cheia').textContent=brl(v); $('#sa-desc').textContent=brl(v-m);
    $('#sa-m').textContent=brl(m); $('#sa-s').textContent=brl(m*6); $('#sa-a').textContent=brl(m*12);
    $('#sa-frase').textContent='Em um ano, são '+brl(m*12)+' de volta para você — quase 5 mensalidades grátis.';
  }
  rg.addEventListener('input',sim); sim();

  /* Passo a passo – destaque ao clicar */
  $$('.step').forEach(function(s){s.addEventListener('click',function(){$$('.step').forEach(function(x){x.classList.remove('on')});s.classList.add('on')})});

  /* Checklist de documentos */
  var docs=$$('.doc');
  docs.forEach(function(d){d.querySelector('input').addEventListener('change',function(){d.classList.toggle('done',this.checked);prog()})});
  function prog(){
    var n=$$('.doc.done').length, t=docs.length;
    $('#sa-pbar').style.width=(n/t*100)+'%';
    $('#sa-ptxt').textContent=n===t?'Tudo pronto! ✅':n+' de '+t;
  }
})();
</script>
